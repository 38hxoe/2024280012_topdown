  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::talk
  lines:
  - speaker: 
    text: "\uCC3D\uBB38 \uC0AC\uC774\uB85C \uC544\uCE68 \uD587\uC0B4\uC774 \uB4E4\uC5B4\uC628\uB2E4."
  - speaker: 
    text: "\uD55C\uB54C\uB294 \uC218\uB9CE\uC740 \uBAA8\uD5D8\uC744 \uB5A0\uB0AC\uC9C0\uB9CC,
      \uC9C0\uAE08\uC740 \uC774 \uC791\uC740 \uB18D\uC7A5\uC5D0\uC11C \uD3C9\uD654\uB85C\uC6B4
      \uD558\uB8E8\uB97C \uBCF4\uB0B4\uACE0 \uC788\uB2E4."
  - speaker: 
    text: "\uC5B4\uC81C \uC4F0\uB2E4 \uB9CC \uB2E4\uC774\uC5B4\uB9AC\uAC00 \uB208\uC5D0
      \uB4E4\uC5B4\uC628\uB2E4."
  - speaker: 
    text: "\uC5B4\uC81C \uC4F0\uB2E4 \uB9CC \uB2E4\uC774\uC5B4\uB9AC\uAC00 \uB208\uC5D0
      \uB4E4\uC5B4\uC628\uB2E4."
  - speaker: 
    text: 
  - speaker: "QUEST 00. \uD558\uB8E8\uC758 \uC2DC\uC791"
    text: "\uCC45\uC0C1 \uC704 \uB2E4\uC774\uC5B4\uB9AC\uB97C \uD655\uC778\uD558\uC790."
  choice1: 
