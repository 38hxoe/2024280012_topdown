--- !u!114 &1154408388
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1154408386}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14923d9bc8214f948b664f72013b8729, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::talk
  lines:
  - speaker: 20XX.XX.08
    text: "\uC774 \uC791\uC740 \uB9C8\uC744\uB85C \uC774\uC0AC \uC628 \uC9C0\uB3C4
      \uC5B4\uB290\uB367 1\uB144. \uD55C\uB54C\uB294 \uC6A9\uC0AC\uB77C\uB294 \uC774\uB984\uC73C\uB85C
      \uC138\uC0C1\uC744 \uB5A0\uB3CC\uC558\uC9C0\uB9CC, \n\uC9C0\uAE08\uC740 \uAC80\uC744
      \uB0B4\uB824\uB193\uACE0 \uC870\uC6A9\uD788 \uB18D\uC7A5\uC744 \uAC00\uAFB8\uBA70
      \uC9C0\uB0B4\uACE0 \uC788\uB2E4. "
  - speaker: 20XX.XX.08
    text: "\uB9C8\uC744\uC740 \uD3C9\uC628\uD558\uACE0 \uC8FC\uBBFC\uB4E4\uB3C4 \uCE5C\uC808\uD558\uB2E4.
      \uC774\uB7F0 \uC0DD\uD65C\uB3C4 \uB098\uC058\uC9C0 \uC54A\uB2E4."
  - speaker: 
    text: ...
  - speaker: 20XX.XX.15
    text: "\uCD5C\uADFC \uB9C8\uC744 \uC8FC\uBCC0\uC5D0 \uBAAC\uC2A4\uD130\uB4E4\uC774
      \uB098\uD0C0\uB098\uAE30 \uC2DC\uC791\uD588\uB2E4. \uCC98\uC74C\uC5D0\uB294
      \uBA87 \uB9C8\uB9AC\uBFD0\uC774\uC5C8\uC9C0\uB9CC, \n\uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D
      \uCE68\uC785\uD558\uB294 \uD69F\uC218\uAC00 \uB298\uC5B4\uB098\uACE0 \uC788\uB2E4. "
  - speaker: 20XX.XX.15
    text: "\uB18D\uC791\uBB3C\uC774 \uB9DD\uAC00\uC9C0\uACE0 \uC6B8\uD0C0\uB9AC\uAE4C\uC9C0
      \uBD80\uC11C\uC9C0\uB294 \uB4F1 \uC8FC\uBBFC\uB4E4\uC758 \uD53C\uD574\uB3C4
      \uC810\uC810 \uCEE4\uC9C0\uB294 \uBAA8\uC591\uC774\uB2E4."
  - speaker: 
    text: ...
  - speaker: 20XX.XX.18
    text: "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uB3C4 \uAF64 \uAC71\uC815\uD558\uB294
      \uB208\uCE58\uB2E4. \uC544\uBB34\uB798\uB3C4 \uAC00\uB9CC\uD788 \uC9C0\uCF1C\uBCF4\uACE0\uB9CC
      \uC788\uC744 \uC218\uB294 \uC5C6\uACA0\uB2E4."
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  prompt: {fileID: 67453784}
  dialogueBox: {fileID: 1888496622}
