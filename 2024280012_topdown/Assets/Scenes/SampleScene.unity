--- !u!114 &732398677
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 732398676}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14923d9bc8214f948b664f72013b8729, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::talk
  lines:
  - speaker: "\uCD0C\uC7A5"
    text: "\uC790\uB128 \uB204\uAD70\uAC00."
  - speaker: "\uCD0C\uC7A5"
    text: "\uC5EC\uAE34 \uC774\uBC29\uC778 \uCD9C\uC785\uAE08\uC9C0\uC77C\uC138.
      \uB098\uAC00\uC8FC\uAC8C."
  - speaker: "\uB098"
    text: "\uC548\uB155\uD558\uC138\uC694."
  - speaker: "\uB098"
    text: "\uD560\uC544\uBC84\uC9C0\uC758 \uC720\uD488\uC744 \uBC1B\uC73C\uB7EC \uC654\uC5B4\uC694."
  - speaker: "\uCD0C\uC7A5"
    text: "\uD560\uC544\uBC84\uC9C0? "
  - speaker: "\uB098"
    text: "\uB124, \uC81C\uC784\uC2A4 \uD560\uC544\uBC84\uC9C0\uC694. "
  - speaker: "\uCD0C\uC7A5"
    text: "\uD5DB.. \uC81C\uC784\uC2A4\uC758 \uC190\uC790\uB77C\uACE0? \uB4E3\uACE0
      \uBCF4\uB2C8 \uC870\uAE08 \uB2EE\uC740 \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0.. "
  - speaker: "\uCD0C\uC7A5"
    text: "\uC81C\uC784\uC2A4\uB294 \uC815\uB9D0 \uC88B\uC740 \uCE5C\uAD6C\uC600\uC5B4.
      \uB0B4 \uB09A\uC2DC \uC5EC\uD589\uB3C4 \uB298 \uD568\uAED8\uD574\uC8FC\uB358
      \uC0AC\uC774\uC600\uC9C0.."
  - speaker: "\uCD0C\uC7A5"
    text: "\uC6B0\uB9B0 40\uB144 \uB3D9\uC548 \uC8FD\uB9C8\uACE0\uC6B0\uC600\uB2E4\uACE0."
  prompt: {fileID: 1277666914}
  dialogueBox: {fileID: 1888496622}
