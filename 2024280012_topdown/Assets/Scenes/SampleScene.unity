  lines:
  - speaker: "\uB9C8\uC744 \uC774\uC7A5"
    text: "\uC544, \uB9C8\uCE68 \uC798 \uC654\uAD6C\uBA3C.."
  - speaker: "\uB9C8\uC744 \uC774\uC7A5"
    text: "\uC790\uB124\uB3C4 \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uACA0\uC9C0. \uBAAC\uC2A4\uD130\uB4E4\uC758
      \uCE68\uC785\uC774 \uAC08\uC218\uB85D \uC2EC\uD574\uC9C0\uACE0 \uC788\uB124."
  - speaker: "\uB9C8\uC744 \uC774\uC7A5"
    text: "\uC8FC\uBBFC\uB4E4\uB9CC\uC73C\uB85C\uB294 \uB354 \uC774\uC0C1 \uB9C8\uC744\uC744
      \uC9C0\uD0A4\uAE30 \uC5B4\uB824\uC6B4 \uC0C1\uD669\uC774\uC57C.."
  - speaker: 
    text: ...
  - speaker: "\uB9C8\uC744 \uC774\uC7A5"
    text: "\uACFC\uAC70\uC5D0 \uC6A9\uC0AC\uB85C \uD65C\uC57D\uD588\uB358 \uC790\uB124\uB77C\uBA74
      \uC774 \uBB38\uC81C\uB97C \uD574\uACB0\uD560 \uC218 \uC788\uC744\uC9C0\uB3C4
      \uBAA8\uB974\uACA0\uAD70.."
  - speaker: "\uB098"
    text: "(\uD55C\uB3D9\uC548 \uAC80\uC744 \uC7A1\uC9C0 \uC54A\uC558\uC9C0\uB9CC..
      \uB9C8\uC744\uC744 \uADF8\uB0E5 \uB0B4\uBC84\uB824 \uB458 \uC218\uB294 \uC5C6\uACA0\uC9C0..)"
