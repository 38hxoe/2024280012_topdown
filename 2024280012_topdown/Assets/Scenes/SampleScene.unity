  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::talk
  lines:
  - speaker: "\uB098"
    text: "\uC548\uB155\uD558\uC138\uC694, \uD53C\uD130 \uD560\uC544\uBC84\uC9C0."
  - speaker: "\uB9C8\uC744 \uC8FC\uBBFC 1"
    text: "\uC548\uB155\uD558\uC9C0 \uBABB\uD558\uB124! \uC694\uC998 \uAC19\uC740
      \uC0C1\uD669\uC5D0 \uC5B4\uB5BB\uAC8C \uC548\uB155\uD558\uACA0\uB098!"
  - speaker: "\uB098"
    text: "\uC544\uCE68\uBD80\uD130 \uC65C \uADF8\uB807\uAC8C \uD654\uAC00 \uB098\uC2E0
      \uAC70\uC608\uC694?"
  - speaker: "\uB9C8\uC744 \uC8FC\uBBFC 1"
    text: "\uB610 \uBAAC\uC2A4\uD130\uB4E4\uC774\uC57C! \uC774\uBC88\uC5D0\uB294
      \uC6B8\uD0C0\uB9AC\uAE4C\uC9C0 \uBD80\uC234 \uB193\uACE0 \uAC14\uC9C0 \uBB54\uAC00!"
  - speaker: "\uB9C8\uC744 \uC8FC\uBBFC 1"
    text: "\uB9E4\uBC88 \uC218\uB9AC\uD558\uB294 \uAC83\uB3C4 \uC9C0\uAE0B\uC9C0\uAE0B\uD558\uB124."
  choice1: 
  choice2: 
  onChoice1:
